{
  "name": "randomspin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.dev.prisma && next dev",
    "start": "next start",
    "build": "prisma generate && next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "node --disable-warning=ExperimentalWarning scripts/setup-sqlite-dev.mjs && prisma generate --schema prisma/schema.dev.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "verify:staging": "tsx scripts/verify-staging.ts",
    "verify:upstash": "tsx scripts/verify-upstash.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "13.0.0",
    "lucide-react": "^1.26.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.17.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
