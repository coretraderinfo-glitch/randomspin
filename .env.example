# LOCAL DEVELOPMENT
# Use SQLite locally. Do not set DATABASE_URL or DIRECT_URL for local-only testing.
APP_ENV="development"
SQLITE_DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_BOOTSTRAP_EMAIL="owner@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-long-unique-password"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Generate with: openssl rand -base64 32
ADMIN_TOTP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
SPIN_RATE_LIMIT_PER_MINUTE=40
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=8
ADMIN_TOTP_RATE_LIMIT_PER_MINUTE=6

# RAILWAY STAGING / PRODUCTION
# Use separate Railway PostgreSQL and Upstash Redis resources for each environment.
# Do not set SQLITE_DATABASE_URL on Railway.
# APP_ENV should be "staging" for Railway staging and "production" only for the final production environment.
# DATABASE_URL should be the Railway PostgreSQL URL used by the deployed web service.
# DIRECT_URL should be the PostgreSQL URL used for Prisma migrations; on Railway staging it may be the same direct database URL as DATABASE_URL.
# NEXT_PUBLIC_SITE_URL should be the exact Railway-generated staging URL or final production domain for that environment.
# APP_ENV="staging"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/randomspin"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/randomspin"
# NEXTAUTH_SECRET="generate-a-unique-secret-for-this-environment"
# ADMIN_BOOTSTRAP_EMAIL="staging-admin@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="choose-a-strong-staging-only-password"
# NEXT_PUBLIC_SITE_URL="https://your-railway-generated-url.up.railway.app"
# UPSTASH_REDIS_REST_URL="https://YOUR-STAGING-REDIS.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-staging-redis-rest-token"
# ADMIN_TOTP_ENCRYPTION_KEY="generate-a-unique-32-byte-base64-key-for-this-environment"
# SPIN_RATE_LIMIT_PER_MINUTE=40
# ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=8
# ADMIN_TOTP_RATE_LIMIT_PER_MINUTE=6
